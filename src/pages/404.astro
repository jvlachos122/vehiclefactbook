---
import Base from "../layouts/Base.astro";
import Answer from "../components/Answer.astro";
import { loadMeta } from "../lib/catalog.js";
import { formatDate, formatNumber } from "../lib/format.js";

const meta = loadMeta();
const text = `VehicleFactbook has no page at this address. The lookup covers ${formatNumber(meta.counts.publishedMmy)} model years from the EPA fuel-economy file dated ${formatDate(meta.dates.epa)}.`;
---

<Base
  title="Page not found"
  description="That page is not on VehicleFactbook. Look up a make, model, and model year, or use the fuel-cost calculator."
  noindex
  canonicalPath="/404.html"
  breadcrumbs={[{ label: "Home", href: "/" }, { label: "Not found", href: "/404.html" }]}
>
  <article class="wrap">
    <h1>Page not found</h1>
    <Answer text={text} />
    <p class="actions">
      <a class="button" href="/recalls/lookup/">Recall and complaint lookup</a>
      <a class="button button-ghost" href="/">Home</a>
    </p>
  </article>
</Base>
