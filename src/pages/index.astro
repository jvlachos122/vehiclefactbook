---
import Base from "../layouts/Base.astro";
import Answer from "../components/Answer.astro";
import DataNote from "../components/DataNote.astro";
import { loadMeta, loadSummary } from "../lib/catalog.js";
import { loadEvRangePages } from "../lib/ev-range.js";
import { loadFuelCostPages } from "../lib/fuel-classes.js";
import { loadSafetyPages } from "../lib/safety-ratings.js";
import { loadScorePages } from "../lib/scores.js";
import { loadInvestigationPages } from "../lib/investigations.js";
import { homeAnswer } from "../lib/answer.js";
import { formatNumber, metaDescription } from "../lib/format.js";
import { site } from "../lib/site.js";

const meta = loadMeta();
const summary = loadSummary();
const text = homeAnswer(meta.counts, meta.dates);
const makes = [...summary.makes].sort((a, b) => a.name.localeCompare(b.name));
const evRangePages = loadEvRangePages();
const fuelCostPages = loadFuelCostPages();
const safetyPages = loadSafetyPages();
const scorePages = loadScorePages();
---

<Base
  home
  title="VehicleFactbook — recalls, complaints, ratings, and MPG"
  description={metaDescription(text)}
  canonicalPath="/"
  breadcrumbs={[{ label: "Home", href: "/" }]}
>
  <section class="wrap">
    <p class="eyebrow">From the federal files</p>
    <h1>Recalls, complaints, ratings, and MPG for a car's model year.</h1>
    <p class="lede">{site.tagline}</p>
    <Answer text={text} />
    <DataNote />
    <h2>Tools</h2>
    <ul class="make-list">
      <li><a href="/tools/fuel-cost-calculator/">Fuel cost calculator <span class="num">EPA mpg</span></a></li>
      <li><a href="/fuel-cost/">Annual fuel cost by class <span class="num">{formatNumber(fuelCostPages.length)}</span></a></li>
      <li><a href="/safety-ratings/">NHTSA 5-star ratings by class <span class="num">{formatNumber(safetyPages.length)}</span></a></li>
      <li><a href="/smog-and-ghg-scores/">Smog and greenhouse gas scores <span class="num">{formatNumber(scorePages.length)}</span></a></li>
      <li><a href="/tools/fuel-cost-calculator/#trip">Trip fuel cost <span class="num">miles × price</span></a></li>
      <li><a href="/tools/mpg-calculator/">MPG calculator <span class="num">miles ÷ gallons</span></a></li>
      <li><a href="/recalls/lookup/">Recall and complaint lookup <span class="num">{formatNumber(meta.counts.publishedMmy)}</span></a></li>
      <li><a href="/compare/">Compare two model years</a></li>
      <li><a href="/compare/hybrid/">Hybrid vs gasoline <span class="num">same model</span></a></li>
      <li><a href="/investigations/">Investigations <span class="num">{formatNumber(loadInvestigationPages().length)}</span></a></li>
      <li><a href="/ev-range/">EV range by year <span class="num">{formatNumber(evRangePages.length)}</span></a></li>
    </ul>
    <h2>Recall lists</h2>
    <ul class="stats">
      <li class="stat"><a href="/recalls/do-not-drive/"><b>{formatNumber(meta.counts.doNotDrive)}</b><span>Do not drive</span></a></li>
      <li class="stat"><a href="/recalls/park-outside/"><b>{formatNumber(meta.counts.parkOutside)}</b><span>Park outside</span></a></li>
      <li class="stat"><a href="/recalls/takata-airbag/"><b>{formatNumber(meta.counts.takata)}</b><span>Takata wording</span></a></li>
      <li class="stat"><a href="/recalls/this-week/"><b>{formatNumber(meta.counts.thisWeek)}</b><span>Newest report week</span></a></li>
    </ul>
    <h2>Makes</h2>
    <p class="small muted">EPA make names for model year 2000 and newer. Mini and MINI share one page.</p>
    <ul class="make-list">
      {
        makes.map((make) => (
          <li>
            <a href={`/${make.slug}/`}>
              {make.name} <span class="num">{formatNumber(make.models.length)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
