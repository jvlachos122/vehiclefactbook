---
import { readFileSync } from "node:fs";
import Base from "../../layouts/Base.astro";
import Answer from "../../components/Answer.astro";
import { loadMeta } from "../../lib/catalog.js";
import { loadPriceSnapshot } from "../../lib/eia-prices.js";
import { tripFuelAnswer } from "../../lib/fuel-cost.js";
import { formatDate, formatNumber, metaDescription } from "../../lib/format.js";
import { webApp } from "../../lib/schema.js";

const meta = loadMeta();
const prices = loadPriceSnapshot(readFileSync(new URL("../../../data/eia-fuel-prices.csv", import.meta.url), "utf8"));
const retrieved = prices.find((row) => row.retrieved)?.retrieved;
if (!retrieved) throw new Error("EIA snapshot has no retrieved date");
const text = tripFuelAnswer({
  epaDate: formatDate(meta.dates.epa),
  epaRows: formatNumber(meta.counts.epaRowsMy2000),
  retrieved: formatDate(retrieved),
});
---

<Base
  title="Trip fuel cost"
  description={metaDescription(text)}
  canonicalPath="/tools/trip-fuel-cost/"
  refreshPath="/tools/fuel-cost-calculator/#trip"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Trip fuel cost", href: "/tools/trip-fuel-cost/" },
  ]}
  jsonLd={[
    webApp({
      name: "Trip fuel cost",
      description: "Trip fuel cost from EPA combined mpg or kWh/100 mi, trip miles, and a price you can replace.",
      url: "https://vehiclefactbook.com/tools/trip-fuel-cost/",
    }),
  ]}
>
  <article class="wrap">
    <h1>Trip fuel cost</h1>
    <Answer text={text} />
    <p>
      <a href="/tools/fuel-cost-calculator/#trip">Open the fuel-cost calculator in trip mode</a>.
      Annual mode on that page starts at 15,000 miles.
    </p>
    <h2>Formula</h2>
    <div class="table-wrap">
      <table>
        <caption>Trip cost uses the same formulas as the annual calculation. Only the miles change.</caption>
        <thead>
          <tr>
            <th>Situation</th>
            <th>Calculation</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Combined mpg</td>
            <td>trip miles ÷ EPA combined mpg × dollars per gallon</td>
          </tr>
          <tr>
            <td>City and highway split</td>
            <td>city miles ÷ city mpg, plus highway miles ÷ highway mpg, then × dollars per gallon</td>
          </tr>
          <tr>
            <td>Electric</td>
            <td>trip miles × EPA combined kWh/100 mi ÷ 100 × dollars per kWh</td>
          </tr>
          <tr>
            <td>Cost per mile</td>
            <td>cost ÷ trip miles</td>
          </tr>
        </tbody>
      </table>
    </div>
    <script is:inline>
      location.replace("/tools/fuel-cost-calculator/#trip");
    </script>
  </article>
</Base>
