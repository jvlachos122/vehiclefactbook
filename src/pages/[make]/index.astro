---
import Base from "../../layouts/Base.astro";
import Answer from "../../components/Answer.astro";
import DataNote from "../../components/DataNote.astro";
import MakeRecalls from "../../components/MakeRecalls.astro";
import { findMake, loadMeta, makePaths } from "../../lib/catalog.js";
import { rollup } from "../../lib/answer.js";
import { makeComplaintPath } from "../../lib/make-complaints.js";
import { formatNumber, metaDescription } from "../../lib/format.js";
import {
  makeHubAnswer,
  makeHubCaption,
  makeHubFacts,
  makeYearCaption,
  makeYearComparisonText,
  makeYearCount,
  makeYearEconomy,
  makeYearRows,
  makeYearStars,
  rangeCell,
  starCell,
  yearSpan,
} from "../../lib/make-hub.js";
import { makeInvestigationCount } from "../../lib/investigations.js";
import { dataset } from "../../lib/schema.js";
import { site } from "../../lib/site.js";

export function getStaticPaths() {
  return makePaths();
}

const meta = loadMeta();
const make = findMake(Astro.params.make);
const models = [...make.models].sort((a, b) => a.name.localeCompare(b.name));
const hub = makeHubFacts(make);
const campaigns = hub.campaigns;
const facts = hub.facts;
const rows = hub.rows;
const text = makeHubAnswer(make.name, rows, facts, meta.dates);
const caption = makeHubCaption(make.name, meta.dates);
const yearRows = makeYearRows(make);
const yearComparisons = makeYearComparisonText(make.name, yearRows);
const yearCaption = makeYearCaption(make.name, meta.dates);
const totals = rollup(models);
const path = `/${make.slug}/`;
const complaintPath = makeComplaintPath(make.slug);
const crumbs = [
  { label: "Home", href: "/" },
  { label: make.name, href: path },
];
---

<Base
  title={`${make.name} recalls, complaints, and safety ratings`}
  description={metaDescription(text)}
  canonicalPath={path}
  breadcrumbs={crumbs}
  jsonLd={[
    dataset({
      name: `${make.name} recalls, complaints, and fuel economy`,
      description: text,
      url: new URL(path, site.url).href,
      dateModified: meta.dates.complaints,
    }),
  ]}
>
  <article class="wrap">
    <p class="eyebrow">Make</p>
    <h1>{make.name} recalls, complaints, and safety ratings</h1>
    <Answer text={text} />
    <DataNote />
    <p>
      {
        complaintPath ? (
          <>
            <a href={complaintPath}>{make.name} complaints</a> lists those complaint counts by model, by model year, and by the year NHTSA received them.{" "}
          </>
        ) : null
      }
      <a href="#recalls">{make.name} recalls</a> lists the matched campaigns on this page.
    </p>
    <ul class="stats">
      <li class="stat"><b>{formatNumber(totals.models)}</b><span>Models</span></li>
      <li class="stat"><b>{formatNumber(totals.mmy)}</b><span>Model years</span></li>
      <li class="stat"><b>{formatNumber(facts.total)}</b><span>Campaigns</span></li>
      <li class="stat"><b>{formatNumber(totals.recalls)}</b><span>Recall rows, summed</span></li>
      <li class="stat"><b>{formatNumber(rows.reduce((sum, row) => sum + row.complaints, 0))}</b><span>Distinct complaints</span></li>
      <li class="stat"><b>{formatNumber(facts.dnd)}</b><span>Do-not-drive campaigns</span></li>
      <li class="stat"><b>{formatNumber(facts.park)}</b><span>Park-outside campaigns</span></li>
    </ul>
    <MakeRecalls makeName={make.name} makeSlug={make.slug} campaigns={campaigns} recallDate={meta.dates.recalls} />
    {
      makeInvestigationCount(make.slug) ? (
        <p>
          <a href="/investigations/">Investigation pages</a> list actions with no close date in the NHTSA file that include a {make.name} model year. The action number on the model year page links to that investigation.
        </p>
      ) : null
    }
    <h2>Models</h2>
    <div class="table-wrap">
      <table>
        <caption>{caption}</caption>
        <thead>
          <tr>
            <th>Model</th>
            <th>Model years</th>
            <th class="num">Recall campaigns</th>
            <th class="num">Distinct complaints</th>
            <th class="num">NCAP overall</th>
            <th class="num">EV range (miles)</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <td><a href={row.path}>{row.name}</a></td>
                <td>{yearSpan(row)}</td>
                <td class="num">{formatNumber(row.campaigns)}</td>
                <td class="num">{formatNumber(row.complaints)}</td>
                <td class="num">{starCell(row)}</td>
                <td class="num">{rangeCell(row)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <section id="make-years">
      <h2>Figures by model year</h2>
      <p>{yearComparisons}</p>
      <p class="years-caveat">
        Recall and complaint figures add the matched model-year counts. They are not rates.{" "}
        <a href="/methodology/">How the files are counted</a>.
      </p>
      <div class="table-wrap">
        <table>
          <caption>{yearCaption}</caption>
          <thead>
            <tr>
              <th scope="col">Model year</th>
              <th class="num" scope="col">Models</th>
              <th scope="col">EPA combined</th>
              <th class="num" scope="col">Recall counts, summed</th>
              <th class="num" scope="col">Complaints, summed</th>
              <th scope="col">NCAP overall</th>
            </tr>
          </thead>
          <tbody>
            {
              yearRows.map((row) => (
                <tr>
                  <td>{row.y}</td>
                  <td class="num">{formatNumber(row.models)}</td>
                  <td>{makeYearEconomy(row)}</td>
                  <td class="num">{makeYearCount(row, "recalls")}</td>
                  <td class="num">{makeYearCount(row, "complaints")}</td>
                  <td>{makeYearStars(row)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </article>
</Base>
