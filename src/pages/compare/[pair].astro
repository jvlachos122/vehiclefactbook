---
import Base from "../../layouts/Base.astro";
import Answer from "../../components/Answer.astro";
import DataNote from "../../components/DataNote.astro";
import { loadExamplePairs, loadRemovedPairRedirects, ncapFetchedAt, pairDocument, redirectAnswer } from "../../lib/compare-pairs.js";
import { loadMeta } from "../../lib/catalog.js";
import { metaDescription } from "../../lib/format.js";
import { dataset } from "../../lib/schema.js";
import { site } from "../../lib/site.js";

export function getStaticPaths() {
  const paths = [];
  const slugs = new Set();
  for (const pair of loadExamplePairs()) {
    if (slugs.has(pair.slug)) throw new Error(`Duplicate comparison slug ${pair.slug}`);
    slugs.add(pair.slug);
    paths.push({ params: { pair: pair.slug }, props: { pair, redirect: null } });
  }
  for (const redirect of loadRemovedPairRedirects()) {
    if (slugs.has(redirect.slug)) throw new Error(`Redirect collides with a live comparison ${redirect.slug}`);
    slugs.add(redirect.slug);
    paths.push({ params: { pair: redirect.slug }, props: { pair: null, redirect } });
  }
  return paths;
}

const { pair, redirect } = Astro.props;
const meta = loadMeta();
const moved = Boolean(redirect);
const doc = moved
  ? null
  : pairDocument(pair, {
      dates: meta.dates,
      ncapFetched: ncapFetchedAt(meta, pair.year),
    });
const answer = moved ? redirectAnswer(redirect) : doc.answer;
const title = moved ? redirect.title : doc.title;
const path = `/compare/${moved ? redirect.slug : pair.slug}/`;
const crumbs = [
  { label: "Home", href: "/" },
  { label: "Compare", href: "/compare/" },
  { label: title, href: path },
];
const year = moved ? redirect.year : pair.year;
const nextPath = moved ? redirect.replacementPath : "";
---

<Base
  title={title}
  description={metaDescription(answer)}
  canonicalPath={moved ? redirect.replacementPath : path}
  noindex={moved}
  refreshPath={moved ? redirect.replacementPath : ""}
  breadcrumbs={crumbs}
  jsonLd={[
    dataset({
      name: title,
      description: moved
        ? `This example comparison is not in the current set. The replacement page is ${redirect.replacementTitle}.`
        : `EPA fuel economy and NHTSA recall counts, complaint counts, and overall stars for the ${pair.year} ${pair.left.makeName} ${pair.left.modelName} and the ${pair.year} ${pair.right.makeName} ${pair.right.modelName}.`,
      url: new URL(path, site.url).href,
      dateModified: meta.dates.complaints,
      temporalCoverage: String(year),
    }),
  ]}
>
  <article class="wrap">
    {
      moved ? (
        <>
          <p class="eyebrow">Example comparison</p>
          <h1>{title}</h1>
          <Answer text={answer} />
          <DataNote />
          <p>
            <a href={redirect.replacementPath}>{redirect.replacementTitle}</a>
          </p>
          <script is:inline define:vars={{ next: nextPath }}>
            location.replace(next);
          </script>
        </>
      ) : (
        <>
          <p class="eyebrow">{doc.eyebrow}</p>
          <h1>{doc.title}</h1>
          <p>{doc.classLine}</p>
          <Answer text={doc.answer} />
          <DataNote />
          <p>{doc.caveat}</p>
          <h2>{doc.tableHeading}</h2>
          <div class="table-wrap">
            <table>
              <caption>{doc.tableCaption}</caption>
              <thead>
                <tr>
                  <th scope="col">Figure</th>
                  {
                    doc.columns.map((column) => (
                      <th scope="col">
                        <a href={column.href}>{column.heading}</a>
                      </th>
                    ))
                  }
                </tr>
              </thead>
              <tbody>
                {
                  doc.rows.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      <td class={row.numeric ? "num" : undefined}>{row.left}</td>
                      <td class={row.numeric ? "num" : undefined}>{row.right}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          {doc.notes.map((note) => <p>{note}</p>)}
          <h2>{doc.linksHeading}</h2>
          <ul>
            {
              doc.columns.map((column) => (
                <li>
                  <a href={column.href}>{column.heading}</a>
                  {" · "}
                  <a href={column.nhtsaHref}>{column.heading} at NHTSA</a>
                </li>
              ))
            }
          </ul>
          <p>{doc.narrativeNote}</p>
          <h2>{doc.sourcesHeading}</h2>
          <ul>
            {doc.sources.map((source) => <li>{source}</li>)}
          </ul>
          <p>
            <a href="/compare/">All example comparisons</a>
            {" · "}
            <a href="/compare/hybrid/">Hybrid vs gasoline</a>
          </p>
        </>
      )
    }
  </article>
</Base>
