---
import { investigationPath } from "../lib/investigations.js";
import { plain, formatDate } from "../lib/format.js";

const { investigations = [], cap = 6 } = Astro.props;
const shown = investigations.slice(0, cap);
const linked = shown.some((item) => investigationPath(item.action));
const extra = [];
const seen = new Set();
for (const item of investigations.slice(cap)) {
  const action = String(item?.action || "").trim();
  const path = investigationPath(action);
  if (!path || seen.has(action)) continue;
  seen.add(action);
  extra.push({ action, path });
}
---

{
  shown.length ? (
    <div class="table-wrap">
      <table>
        <caption>
          Investigations in the NHTSA file ({investigations.length.toLocaleString("en-US")}). "No close date" means the file has no close date. It is not a statement that the investigation is still active.
        </caption>
        <thead>
          <tr>
            <th>Action</th>
            <th>Subject</th>
            <th>Opened</th>
            <th>Closed</th>
          </tr>
        </thead>
        <tbody>
          {shown.map((item) => {
            const path = investigationPath(item.action);
            return (
            <tr>
              <td class="mono">{path ? <a href={path}>{item.action}</a> : item.action}</td>
              <td>
                {plain(item.subject, 180)}
                {item.component ? <span class="small muted"> · {plain(item.component, 120)}</span> : null}
              </td>
              <td>{formatDate(item.opened) || "—"}</td>
              <td>{item.closeDateInFile ? formatDate(item.closed) || "Date in file" : "No close date in the file"}</td>
            </tr>
            );
          })}
        </tbody>
      </table>
      {investigations.length > shown.length ? (
        <p class="small muted">{(investigations.length - shown.length).toLocaleString("en-US")} more actions are in the file and are not listed in this table.</p>
      ) : null}
      {extra.length ? (
        <p class="small muted">
          Investigation pages for actions past the rows above:
          {extra.map((item, index) => (
            <span>
              {index ? ", " : " "}
              <a href={item.path}>{item.action}</a>
            </span>
          ))}
          .
        </p>
      ) : null}
      {linked ? (
        <p class="small muted">An action number links to its page on this site when one is published.</p>
      ) : null}
    </div>
  ) : (
    <p>No investigations are matched to this name.</p>
  )
}
