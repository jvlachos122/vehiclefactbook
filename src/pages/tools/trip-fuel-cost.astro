---
import Base from "../../layouts/Base.astro";
import Answer from "../../components/Answer.astro";
import { loadMeta } from "../../lib/catalog.js";
import { formatDate, formatNumber, metaDescription } from "../../lib/format.js";
import { webApp } from "../../lib/schema.js";

const meta = loadMeta();
const text = `Trip cost uses the same EPA file dated ${formatDate(meta.dates.epa)} (${formatNumber(meta.counts.epaRowsMy2000)} rows for model year 2000 and newer). Enter trip miles and a price. Nothing is prefilled for price, and trip miles start empty.`;
---

<Base
  title="Trip fuel cost"
  description={metaDescription(text)}
  canonicalPath="/tools/trip-fuel-cost/"
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Trip fuel cost", href: "/tools/trip-fuel-cost/" },
  ]}
  jsonLd={[
    webApp({
      name: "Trip fuel cost",
      description: "Trip fuel cost from EPA combined mpg or kWh/100 mi, trip miles, and a price you enter.",
      url: "https://vehiclefactbook.com/tools/trip-fuel-cost/",
    }),
  ]}
>
  <article class="wrap">
    <h1>Trip fuel cost</h1>
    <Answer text={text} />
    <script is:inline>
      if (location.search) {
        const meta = document.createElement("meta");
        meta.name = "robots";
        meta.content = "noindex";
        document.head.appendChild(meta);
      }
    </script>
    <form class="controls" data-fuel data-mode="trip">
      <label>Make <select name="make"><option value="">Select a make</option></select></label>
      <label>Model <select name="model"><option value="">Select a model</option></select></label>
      <label>Model year <select name="year"><option value="">Select a year</option></select></label>
      <label>Configuration <select name="config"><option value="">Select a configuration</option></select></label>
      <label>Trip miles <input type="number" name="miles" min="0" step="1" inputmode="numeric" /></label>
      <label>Price per gallon (USD) <input type="number" name="price" min="0" step="0.01" inputmode="decimal" /></label>
      <label>Price per kWh (USD) <input type="number" name="kwhPrice" min="0" step="0.01" inputmode="decimal" /></label>
      <button type="submit">Calculate</button>
    </form>
    <div class="panel" data-fuel-result><p>Select a configuration and enter trip miles.</p></div>
    <p>Annual mode, with EPA's 15,000-mile starting point, is the <a href="/tools/fuel-cost-calculator/">fuel cost calculator</a>.</p>
  </article>
</Base>
<script>
  import "../../scripts/fuel.js";
</script>
