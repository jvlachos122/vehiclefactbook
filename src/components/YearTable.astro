---
import { span } from "../lib/format.js";
import { countCell, mpgCell, starsCell } from "../lib/years.js";

const {
  rows = [],
  makeSlug,
  modelSlug,
  sortable = false,
  notListed = false,
  caption = "",
} = Astro.props;

function legacyStars(row) {
  if (row.y < 2011) return "Pre-2011 rating, not comparable";
  if (row.starMin == null) return "—";
  if (row.starMin === row.starMax) return String(row.starMin);
  return `${row.starMin}–${row.starMax}`;
}

function cells(row) {
  if (!notListed) {
    const mpgText = span(row.mpgMin, row.mpgMax) || (row.mpgeMin != null ? `${span(row.mpgeMin, row.mpgeMax)} MPGe` : "—");
    return {
      recalls: { text: row.recalls.toLocaleString("en-US"), sort: row.recalls },
      complaints: { text: row.complaints.toLocaleString("en-US"), sort: row.complaints },
      crash: { text: row.crash.toLocaleString("en-US"), sort: row.crash },
      fire: { text: row.fire.toLocaleString("en-US"), sort: row.fire },
      investigations: { text: row.investigations.toLocaleString("en-US"), sort: row.investigations },
      stars: { text: legacyStars(row), sort: row.starMax ?? -1 },
      mpg: { text: mpgText, sort: row.mpgMax ?? -1 },
    };
  }
  return {
    recalls: countCell(row, "recalls"),
    complaints: countCell(row, "complaints"),
    crash: countCell(row, "crash"),
    fire: countCell(row, "fire"),
    investigations: countCell(row, "investigations"),
    stars: starsCell(row),
    mpg: mpgCell(row),
  };
}

const rendered = rows.map((row) => ({ row, cells: cells(row) }));
const captionText = caption || "One row per model year. Complaint and recall figures are matched raw counts.";
---

<div class="table-wrap">
  <table class={sortable ? "sortable" : undefined}>
    <caption>{captionText}</caption>
    <thead>
      <tr>
        <th>{sortable ? <button type="button">Year</button> : "Year"}</th>
        <th class="num">{sortable ? <button type="button">Recalls</button> : "Recalls"}</th>
        <th class="num">{sortable ? <button type="button">Complaints</button> : "Complaints"}</th>
        <th class="num">{sortable ? <button type="button">Crash</button> : "Crash"}</th>
        <th class="num">{sortable ? <button type="button">Fire</button> : "Fire"}</th>
        <th class="num">{sortable ? <button type="button">Investigations</button> : "Investigations"}</th>
        <th>{sortable ? <button type="button">Stars</button> : "Stars"}</th>
        <th class="num">{sortable ? <button type="button">Comb mpg</button> : "Comb mpg"}</th>
      </tr>
    </thead>
    <tbody>
      {
        rendered.map(({ row, cells: cell }) => (
          <tr>
            <td data-value={row.y}>
              <a href={`/${makeSlug}/${modelSlug}/${row.y}/`}>{row.y}</a>
              {row.match === "none" ? <span class="small muted"> · no NHTSA name match</span> : null}
            </td>
            <td class="num" data-value={cell.recalls.sort}>{cell.recalls.text}</td>
            <td class="num" data-value={cell.complaints.sort}>{cell.complaints.text}</td>
            <td class="num" data-value={cell.crash.sort}>{cell.crash.text}</td>
            <td class="num" data-value={cell.fire.sort}>{cell.fire.text}</td>
            <td class="num" data-value={cell.investigations.sort}>{cell.investigations.text}</td>
            <td data-value={cell.stars.sort}>{cell.stars.text}</td>
            <td class="num" data-value={cell.mpg.sort}>{cell.mpg.text}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
