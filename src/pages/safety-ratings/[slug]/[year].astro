---
import Base from "../../../layouts/Base.astro";
import Answer from "../../../components/Answer.astro";
import DataNote from "../../../components/DataNote.astro";
import SafetyRatingTable from "../../../components/SafetyRatingTable.astro";
import { loadMeta } from "../../../lib/catalog.js";
import { metaDescription } from "../../../lib/format.js";
import { dataset, epaOrg, faqPage, nhtsaOrg } from "../../../lib/schema.js";
import {
  SAFETY_INDEX,
  emptyFiveSentence,
  findSafetyPage,
  fuelCostLink,
  safetyFaqs,
  safetySourceParts,
  safetyYearAnswer,
  safetyYearPaths,
} from "../../../lib/safety-ratings.js";
import { site } from "../../../lib/site.js";

export function getStaticPaths() {
  return safetyYearPaths();
}

const { slug } = Astro.props;
const year = Number(Astro.props.year);
const page = findSafetyPage(slug);
const yearRow = page?.byYear.find((item) => item.year === year);
if (!page || !yearRow?.path) throw new Error(`Missing safety rating year ${slug} ${year}`);
const meta = loadMeta();
const text = safetyYearAnswer(page, yearRow);
const faqs = safetyFaqs(page, [year]);
const source = safetySourceParts(page, meta.dates.epa, year);
const fuel = fuelCostLink(page);
const path = yearRow.path;
---

<Base
  title={`NHTSA 5-star rated ${page.plural} in ${year}`}
  description={metaDescription(text)}
  canonicalPath={path}
  breadcrumbs={[
    { label: "Home", href: "/" },
    { label: "Safety ratings", href: SAFETY_INDEX },
    { label: page.label, href: page.path },
    { label: String(year), href: path },
  ]}
  jsonLd={[
    dataset({
      name: `NHTSA 5-star rated ${page.plural} in ${year}`,
      description: text,
      url: new URL(path, site.url).href,
      dateModified: page.fetchedByYear[year],
      creators: [nhtsaOrg, epaOrg],
      temporalCoverage: String(year),
    }),
    faqPage(faqs),
  ]}
>
  <article class="wrap">
    <p class="eyebrow">NHTSA Safety Ratings</p>
    <h1>NHTSA 5-star rated {page.plural} in {year}</h1>
    <Answer text={text} />
    <DataNote />
    <p>
      {source.before}<a href={source.apiHref}>{source.apiLabel}</a>{source.middle}<a href={source.epaHref}>{source.epaLabel}</a>{source.after}
    </p>
    <p>
      <a href={page.path}>All model years for this class</a>. <a href={fuel.href}>{fuel.label}</a>{fuel.after}
    </p>
    <h2>5 stars overall</h2>
    {
      yearRow.fiveRows.length ? (
        <SafetyRatingTable caption={yearRow.fiveCaption} rows={yearRow.fiveRows} />
      ) : (
        <p>{emptyFiveSentence()}</p>
      )
    }
    {
      yearRow.otherRows.length ? (
        <>
          <h2>Other overall stars</h2>
          <SafetyRatingTable caption={yearRow.otherCaption} rows={yearRow.otherRows} />
        </>
      ) : null
    }
    {
      yearRow.notRatedRows.length ? (
        <>
          <h2>Not rated</h2>
          <SafetyRatingTable caption={yearRow.notRatedCaption} rows={yearRow.notRatedRows} />
        </>
      ) : null
    }
    <h2>Questions</h2>
    {
      faqs.map((faq) => (
        <section>
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </section>
      ))
    }
  </article>
</Base>
